@echo off
setlocal enabledelayedexpansion

rem M.U.L.E. NABU PC build (z88dk +nabu, no make needed)
rem
rem   build-nabu.bat                 build r2r\nabu\mule.nabu
rem   build-nabu.bat "C:\path\M.U.L.E. (1983)(Electronic Arts)(US).atr"
rem                                  ... with the art from your own Atari disk
rem   build-nabu.bat clean
rem
rem   set ENDPOINT=https://qalobby.fujinet.online   (the QA lobby), or any server:
rem   set ENDPOINT=http://myhost:8080   before running, to change the server
rem                                     used when none was chosen (default below)
rem   set DEBUG=1                    debug messages on the Internet Adapter's console
rem                                     (release build by default)

rem Toolchain setup
set Z88DK_DIR=c:\z88dk\
set ZCCCFG=%Z88DK_DIR%lib\config\
set PATH=%Z88DK_DIR%bin;%PATH%

rem Deploy path: the Internet Adapter's folder for local .nabu files
rem (leave it missing to skip the copy)
set LOCAL_DIR=c:\nabu\local

set SCRIPT_DIR=%~dp0
set OUT_DIR=%SCRIPT_DIR%r2r\nabu
set OBJ_DIR=%SCRIPT_DIR%build\nabu
set GEN_DIR=%SCRIPT_DIR%gen
if "%ENDPOINT%"=="" set ENDPOINT=http://fujinet.online:9900
set PYTHON=python
rem Debug is ON unless you say set DEBUG=0 (every run recompiles everything,
rem so changing it needs no clean)
if "%DEBUG%"=="" set DEBUG=0

if /I "%~1"=="clean" goto :clean

pushd "%SCRIPT_DIR%"

echo.
echo ****************************************************************************
echo  Building M.U.L.E. for the NABU PC
echo ****************************************************************************

if not exist "%OUT_DIR%" mkdir "%OUT_DIR%"
if not exist "%OBJ_DIR%" mkdir "%OBJ_DIR%"
if not exist "%GEN_DIR%\tms9918" mkdir "%GEN_DIR%\tms9918"

rem ---- generated files: config.h (the server) and the art ------------------
> "%GEN_DIR%\config.h" echo /* GENERATED by build-nabu.bat. */
>> "%GEN_DIR%\config.h" echo #define DEFAULT_ENDPOINT "%ENDPOINT%"

set ATR=%~1
if "%ATR%"=="" if exist "%SCRIPT_DIR%mule.atr" set ATR=%SCRIPT_DIR%mule.atr
if "%ATR%"=="" (
  echo *** WARNING: no Atari disk given: using STAND-IN art
  %PYTHON% tools\mkgfx_tms.py --preview "%GEN_DIR%\preview\tms9918" "%GEN_DIR%\tms9918\gfx.c"
) else (
  %PYTHON% tools\mkgfx_tms.py --atr "%ATR%" --preview "%GEN_DIR%\preview\tms9918" "%GEN_DIR%\tms9918\gfx.c"
)
if errorlevel 1 goto :fail

rem ---- compile every source to its own object ------------------------------
set CFLAGS=+nabu -vn -compiler=sdcc -SO3 -D__NABU__ -DPLAT_NETSTREAM -Isrc -Isrc\platform-specific -Isrc\tms9918 -Isrc\nabu -I. -Igen
if "%DEBUG%"=="1" (
  set CFLAGS=!CFLAGS! -DNABU_DEBUG
  echo *** DEBUG build: messages go to the Internet Adapter console
) else (
  echo *** release build: no debug messages ^(DEBUG=0^)
)
set OBJS=

rem name prefix: src -> "", tms9918 -> tms_, nabu -> nabu_, gen -> gen_
call :compile_dir src ""
if errorlevel 1 goto :fail
call :compile_dir src\tms9918 tms_
if errorlevel 1 goto :fail
call :compile_dir src\nabu nabu_
if errorlevel 1 goto :fail
call :compile_dir gen\tms9918 gen_
if errorlevel 1 goto :fail

rem ---- link: the .nabu the adapter boots -----------------------------------
rem CRT_TRIM_BSS: the zero-filled variables (BSS, ~5K) are left out of the file;
rem the crt0 copies only code + data and clears the BSS itself (CRT_INITIALIZE_BSS)
rem No z88dk screen set-up, stdio or console (the game draws its own text, as
rem Rick Dangerous does): CLIB_DEFAULT_SCREEN_MODE=-1, CRT_ENABLE_STDIO=0 and
rem fputc_cons sent to a stub (nabu_hw.asm) drop the console driver and its font
echo Linking...
zcc +nabu -vn -compiler=sdcc -m -pragma-define:CRT_INITIALIZE_BSS=1 -pragma-define:CRT_TRIM_BSS=1 -pragma-define:CLIB_DEFAULT_SCREEN_MODE=-1 -pragma-define:CRT_ENABLE_STDIO=0 -pragma-redirect:fputc_cons=_fputc_cons_stub -create-app !OBJS! -o "%OUT_DIR%\mule.nabu"
if errorlevel 1 goto :fail

echo.
echo Built %OUT_DIR%\mule.nabu
dir "%OUT_DIR%\mule.nabu" | find "mule.nabu"
for %%A in ("%OUT_DIR%\mule.nabu") do set NABU_SIZE=%%~zA
echo Size: !NABU_SIZE! bytes ^(limit 60401^)
if !NABU_SIZE! GTR 60401 echo *** WARNING: over the 60401 byte limit: build with set DEBUG=0, or trim debug strings

if exist "%LOCAL_DIR%" (
  copy /Y "%OUT_DIR%\mule.nabu" "%LOCAL_DIR%\mule.nabu" >nul
  echo Copied to %LOCAL_DIR%
)
popd
exit /b 0

:compile_dir
rem %1 = directory, %2 = object name prefix
for %%f in (%1\*.c %1\*.asm) do (
  echo   %%f
  set XF=
  rem debug-only code is built for size, not speed
  if /I "%%~nxf"=="dbg.c" set XF=--opt-code-size
  zcc %CFLAGS% !XF! -c -o "%OBJ_DIR%\%~2%%~nf.o" "%%f"
  if errorlevel 1 exit /b 1
  set OBJS=!OBJS! "%OBJ_DIR%\%~2%%~nf.o"
)
exit /b 0

:clean
rmdir /S /Q "%SCRIPT_DIR%build\nabu" 2>nul
rmdir /S /Q "%SCRIPT_DIR%r2r\nabu" 2>nul
rmdir /S /Q "%SCRIPT_DIR%gen" 2>nul
echo Cleaned.
exit /b 0

:fail
echo.
echo *** BUILD FAILED
popd
exit /b 1
